# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/medicio?schema=public"

# --- Sessions ---
# Required in production. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Gmail (optional in development) ---
# When GMAIL_USER/GMAIL_APP_PASSWORD are unset, OTP emails are skipped instead of failing.
# GMAIL_APP_PASSWORD is a Google App Password (myaccount.google.com/apppasswords),
# NOT your regular Gmail password. Requires 2-Step Verification on the account.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM="\"Medicio Portal\" <your-address@gmail.com>"

# --- Seeding (development only) ---
SEED_PASSWORD="Medicio@123"
