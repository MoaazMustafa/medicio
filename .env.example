# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/medicio?schema=public"

# --- Sessions ---
# Required in production. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMTP (optional in development) ---
# When SMTP_USER/SMTP_PASS are unset, OTP emails are skipped instead of failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Medicio Portal\" <noreply@medicio.com>"

# --- Seeding (development only) ---
SEED_PASSWORD="Medicio@123"
