# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/medicio?schema=public"

# --- Sessions (JWT) ---
# Required in production. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- App ---
# For local dev, keep as localhost. On Vercel, set to your actual domain URL.
# This MUST match the domain in Google OAuth "Authorized redirect URIs".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# For Vercel: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Gmail (Nodemailer) ---
# When GMAIL_USER/GMAIL_APP_PASSWORD are unset, OTP emails are skipped in dev.
# In production, unset credentials will cause email dispatch to fail explicitly.
# GMAIL_APP_PASSWORD is a Google App Password (myaccount.google.com/apppasswords),
# NOT your regular Gmail password. Requires 2-Step Verification on the account.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM="Medicio Portal <your-address@gmail.com>"

# --- Seeding (development only) ---
SEED_PASSWORD="Medicio@123"
