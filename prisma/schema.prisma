datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  LAB_ADMIN
  PHARMACY_ADMIN
  ADMIN
  SUPER_ADMIN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         UserRole      @default(PATIENT)
  isVerified   Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doctorProfile           Doctor?
  hospitalProfile         Hospital?
  pharmacyProfile         Pharmacy?
  labProfile              Lab?
  appointments            Appointment[]
  medicineTrackerEntries  MedicineTrackerEntry[]
  reports                 LabReport[]
  aiConversations         AIConversation[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]

  @@map("users")
}

model Doctor {
  id                     String      @id @default(cuid())
  userId                 String      @unique
  specialty              String
  subSpecialty           String?
  education              String
  experience             Int
  licenseNumber          String
  issuingBoard           String?     // Medical Council / Issuing Board (authenticity)
  nationalIdNumber       String?     // National ID / Passport number (authenticity)
  documentUrl            String?     // License Certificate Document Link (authenticity)
  isVerified             Boolean     @default(false)
  verificationStatus     String?     @default("PENDING") // PENDING, APPROVED, REJECTED, ARCHIVED
  rejectionReason        String?
  isReviewRequested      Boolean     @default(false)     // Doctor requested appeal/review
  reviewNotes            String?     // Appeal notes submitted by doctor
  availability           String?     // JSON representation of working slots
  bio                    String?
  clinicAddress          String?
  consultationFee        Float?
  affiliationStatus      String?     @default("INDEPENDENT") // INDEPENDENT, PENDING_DOCTOR_ACCEPT, PENDING_HOSPITAL_ACCEPT, AFFILIATED
  affiliationRequestedBy String?     // DOCTOR or HOSPITAL
  aiTrainingData         String?     // JSON representation of AI training answers
  hospitalId             String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital     Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  applicationHistories DoctorApplicationHistory[]

  @@map("doctors")
}

model DoctorApplicationHistory {
  id               String   @id @default(cuid())
  doctorId         String
  specialty        String
  subSpecialty     String?
  education        String
  experience       Int
  licenseNumber    String
  issuingBoard     String?
  nationalIdNumber String?
  documentUrl      String?
  status           String   // PENDING, APPROVED, REJECTED, ARCHIVED
  rejectionReason  String?
  reviewNotes      String?
  submittedAt      DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, submittedAt])
  @@map("doctor_application_histories")
}

model Hospital {
  id         String   @id @default(cuid())
  userId     String?  @unique
  name       String
  location   String
  facilities String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  doctors Doctor[]
  labs    Lab[]
  pharmacies Pharmacy[]

  @@map("hospitals")
}

model Pharmacy {
  id         String   @id @default(cuid())
  userId     String?  @unique
  hospitalId String?
  name       String
  location   String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital Hospital?              @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  inventory PharmacyInventoryItem[]

  @@map("pharmacies")
}

model PharmacyInventoryItem {
  id         String   @id @default(cuid())
  pharmacyId String
  name       String
  price      Float
  stock      Int
  lastSync   DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("pharmacy_inventory_items")
}

model Lab {
  id         String   @id @default(cuid())
  userId     String?  @unique
  hospitalId String?
  name       String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  reports  LabReport[]

  @@map("labs")
}

model LabReport {
  id         String   @id @default(cuid())
  patientId  String
  labId      String
  testName   String
  resultData String   // JSON or text findings
  fileUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lab     Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@map("lab_reports")
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  dateTime  DateTime
  status    String   // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model MedicineTrackerEntry {
  id                String    @id @default(cuid())
  userId            String
  medicineName      String
  dosage            String
  frequency         String
  startDate         DateTime
  endDate           DateTime?
  reminderTimes     String?   // JSON string[] of daily reminder times e.g. ["08:00", "20:00"]
  isReminderEnabled Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("medicine_tracker_entries")
}

model ScrapedRecord {
  id          String   @id @default(cuid())
  entityType  String   // DOCTOR, HOSPITAL, PHARMACY, LAB
  name        String
  contactInfo String?
  location    String?
  rawDetails  String   // JSON metadata dump
  lastScraped DateTime @default(now())

  @@map("scraped_records")
}

model AIConversation {
  id               String   @id @default(cuid())
  userId           String?
  conversationType String   // SYMPTOM_CHECKER, SPECIALTY_AGENT
  title            String?  // Short chat title derived from the first symptom prompt
  messages         String   // JSON message list
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ai_conversations")
}

model SpecialistAgent {
  id                 String   @id @default(cuid())
  specialty          String   @unique // GENERAL, DERMATOLOGY, CARDIOLOGY, ...
  displayName        String
  description        String
  trainingData       String?  // Admin-authored clinical training context
  suggestedQuestions String   @default("[]") // JSON string[] of preset patient questions
  attachedDoctorIds  String   @default("[]") // JSON string[] of Doctor ids whose training powers this model
  isEnabled          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("specialist_agents")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("SYSTEM") // APPOINTMENT, VERIFICATION, AFFILIATION, ACCOUNT, MEDICINE, LAB, SYSTEM
  title     String
  body      String
  href      String?   // Optional in-app destination opened from the notification
  metadata  Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   // Client public key (Web Push / RFC 8291)
  auth      String   // Client auth secret
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, token])
  @@map("verification_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   // JSON array string of granted module IDs e.g. ["M1", "M2", "M12"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_roles")
}
